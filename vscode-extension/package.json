{
    "name":  "dotnet-expert-advisor",
    "displayName":  ".NET Expert Advisor (Preview)",
    "description":  "Developer preview for the custom C# semantic engine and binder.",
    "version":  "0.1.0-alpha.10",
    "publisher":  "dotnet-expert-advisor",
    "engines":  {
                    "vscode":  "^1.90.0"
                },
    "categories":  [
                       "Programming Languages",
                       "Linters"
                   ],
    "activationEvents":  [
                             "onLanguage:csharp",
                             "onCommand:dotnetExpertAdvisor.startServer"
                         ],
    "main":  "./extension.js",
    "contributes":  {
                        "configuration": {
                            "title": ".NET Expert Advisor",
                            "properties": {
                                "dotnetExpertAdvisor.projectPath": {
                                    "type": "string",
                                    "description": "Absolute path of the active C# project. Required when project ownership is ambiguous."
                                },
                                "dotnetExpertAdvisor.targetFramework": {
                                    "type": "string",
                                    "description": "Active target framework, for example net10.0. Required for multi-target projects."
                                },
                                "dotnetExpertAdvisor.configuration": {
                                    "type": "string",
                                    "default": "Debug",
                                    "description": "MSBuild configuration used to evaluate completion context."
                                },
                                "dotnetExpertAdvisor.completionDebounceMs": {
                                    "type": "number",
                                    "default": 180,
                                    "minimum": 50,
                                    "description": "Delay before refreshing C# suggestions after typing."
                                }
                            }
                        },
                        "commands":  [
                                         {
                                             "command":  "dotnetExpertAdvisor.startServer",
                                             "title":  ".NET Expert Advisor: Start Preview Server"
                                         }
                                     ]
                    },
    "repository":  {
                       "type":  "git",
                       "url":  "https://github.com/0x-mhmdnzri/CsharpExtension.git"
                   }
}
